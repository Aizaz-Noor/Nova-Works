{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["bom1"],
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "app/client/dist",
  "functions": { "api/index.js": { "maxDuration": 120, "includeFiles": "{backend/certs/**,node_modules/pdfkit/js/data/**}" } },
  "routes": [{ "src": "/api/.*", "dest": "/api/index" }, { "handle": "filesystem" }]
}
